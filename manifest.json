{
    "manifest_version": 3,
    "name": "Keypr",
    "version": "0.1.0",
    "description": "Extension Chrome pour notre gestionnaire de mots de passe",
    "key": "",
    "icons": {
        "16": "img/icons/icon16.png",
        "32": "img/icons/icon32.png",
        "48": "img/icons/icon48.png",
        "128": "img/icons/icon128.png"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [{
        "js": ["content/entry.js"],
        "matches": ["http://*/*", "https://*/*"],
        "all_frames": true
    }],
    "web_accessible_resources": [
        {
            "resources": ["img/icons/icon24.png", "img/icons/iconNoBackground32.png", "style/credentials-overlay.css"],
            "matches": ["http://*/*", "https://*/*"]
        }
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "permissions": [
        "nativeMessaging"
    ],
    "action": {
        "default_popup": "popup/popup.html"
    }
}