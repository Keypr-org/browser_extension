{
    "manifest_version": 3,
    "name": "Keypr",
    "version": "0.1.0",
    "description": "Extension Chrome pour notre gestionnaire de mots de passe",
    "background": {
        "service_worker": "dist/background/service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "dist/content/content-script.js"
            ]
        }
    ],
    "permissions": []
}